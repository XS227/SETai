+.sina-sculptures{padding:100px 6vw;background:#061b22;color:#eee9df}.sina-sculpture-heading{max-width:750px;margin-bottom:55px}.sina-sculpture-heading h2{font:400 clamp(2.8rem,5vw,5.4rem)/1.05 Georgia,serif;letter-spacing:-.04em;margin:1.2rem 0}.sina-sculpture-heading p{color:#b5c1c2;line-height:1.7}.sina-sculpture-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:70px 4vw}.sina-sculpture-card{min-width:0;scroll-margin-top:30px}.sina-gallery-main{display:block;width:100%;height:560px;position:relative;overflow:hidden;border:0;background:#d4d5d5;padding:0;cursor:zoom-in;color:#eee9df}.sina-gallery-main>img{width:100%;height:100%;object-fit:contain;display:block}.sina-expand{position:absolute;bottom:14px;inset-inline-end:14px;display:flex;align-items:center;gap:8px;background:#061b22ed;padding:10px 13px;font-size:.7rem;letter-spacing:.04em}.sina-thumbnails{display:flex;gap:9px;padding-top:12px;flex-wrap:wrap}.sina-thumbnails button{position:relative;width:62px;height:76px;border:2px solid transparent;padding:2px;background:#b9b5af;cursor:pointer}.sina-thumbnails button[aria-pressed=true]{border-color:#d5b574}.sina-thumbnails img{width:100%;height:100%;object-fit:contain;display:block}.sina-thumbnails span{position:absolute;bottom:2px;inset-inline-end:2px;background:#061b22;color:#fff;font-size:.65rem;padding:2px 5px}.sina-view-caption{font-size:.76rem;color:#a8babb;line-height:1.5;margin:12px 0 0;min-height:1.5em}.sina-sculpture-meta{padding-top:20px}.sina-sculpture-meta h3{display:flex;align-items:baseline;gap:16px;font:400 2rem Georgia,serif;margin:0 0 20px}.sina-sculpture-meta h3 small{font:400 .85rem system-ui;color:#a8babb}.sina-sculpture-meta dl{margin:0}.sina-sculpture-meta dl>div{display:flex;justify-content:space-between;gap:16px;padding:11px 0;border-top:1px solid #ffffff20;line-height:1.5;font-size:.85rem}.sina-sculpture-meta dt{color:#a8babb}.sina-sculpture-meta dd{margin:0;text-align:end}.sina-sculpture-enquiry{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:22px}.sina-sculpture-enquiry strong{font:400 1rem Georgia,serif}.sina-sculpture-enquiry a{display:flex;align-items:center;gap:9px;border-bottom:1px solid #d5b574;color:#d5b574;padding:8px 0;font-size:.8rem}.sina-studio{margin-top:75px;border-top:1px solid #ffffff30;padding-top:28px;max-width:820px}.sina-studio summary{cursor:pointer;font:400 1.25rem Georgia,serif;color:#d5b574;padding:12px 0}.sina-studio>p{color:#b5c1c2;line-height:1.6;margin:12px 0 25px}.sina-lightbox{position:fixed;inset:0;width:min(96vw,1250px);max-width:96vw;height:94dvh;max-height:94dvh;padding:20px;background:#061b22;color:#eee9df;border:1px solid #ffffff30;margin:auto;box-sizing:border-box}.sina-lightbox::backdrop{background:#000d}.sina-lightbox-content{display:flex;flex-direction:column;height:100%;min-height:0}.sina-lightbox header{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-shrink:0;padding-bottom:14px}.sina-lightbox h3{font:400 1.3rem Georgia,serif;margin:0}.sina-lightbox button{display:flex;align-items:center;gap:7px;background:transparent;border:1px solid #ffffff45;padding:10px;color:inherit;cursor:pointer;min-width:44px;min-height:44px;justify-content:center}.sina-lightbox-image{display:block;width:100%;flex:1;min-height:0;object-fit:contain}.sina-lightbox footer{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:15px 0 0;background:transparent;flex-shrink:0}.sina-lightbox footer p{margin:0;font:400 .85rem/1.5 system-ui;text-align:center;flex:1;color:#c0cbcc}.sina-gallery button:focus-visible,.sina-studio summary:focus-visible,.sina-sculpture-enquiry a:focus-visible{outline:3px solid #e8c98e;outline-offset:4px}
