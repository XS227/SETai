+"use client";
+import {useRef,useState} from "react";
+import {ChevronLeft,ChevronRight,Maximize2,X} from "lucide-react";
+import {T} from "../../i18n";
+
+export type View={src:string;alt:string;label:[string,string,string]};
+export default function SculptureGallery({title,views}:{title:string;views:View[]}){
+ const [index,setIndex]=useState(0);
+ const dialog=useRef<HTMLDialogElement>(null);
+ const view=views[index];
+ const step=(direction:number)=>setIndex(i=>(i+direction+views.length)%views.length);
+ const open=()=>dialog.current?.showModal();
+ return <div className="sina-gallery">
+  <button type="button" className="sina-gallery-main" onClick={open} aria-label={`View ${title} in detail`}>
+   <img src={view.src} alt={view.alt} loading="lazy"/>
+   <span className="sina-expand"><Maximize2 size={15}/><T en="View in detail" no="Se detaljer" fa="مشاهدهٔ جزئیات"/></span>
+  </button>
+  {views.length>1&&<div className="sina-thumbnails" role="group" aria-label={`${title} photographs`}>
+   {views.map((v,i)=><button type="button" key={v.src} aria-pressed={index===i} aria-label={v.alt} onClick={()=>setIndex(i)}><img src={v.src} alt="" loading="lazy"/><span>{i+1}</span></button>)}
+  </div>}
+  <p className="sina-view-caption" aria-live="polite"><T en={view.label[0]} no={view.label[1]} fa={view.label[2]}/>{views.length>1&&<bdi dir="ltr"> · {index+1} / {views.length}</bdi>}</p>
+  <dialog ref={dialog} className="sina-lightbox" aria-label={title} onClick={e=>{if(e.target===e.currentTarget)dialog.current?.close();}} onKeyDown={e=>{if(e.key==="ArrowRight"){e.preventDefault();step(1);}if(e.key==="ArrowLeft"){e.preventDefault();step(-1);}}}>
+   <div className="sina-lightbox-content">
+    <header><h3>{title}</h3><button type="button" autoFocus onClick={()=>dialog.current?.close()} aria-label="Close / Lukk / بستن"><X/><T en="Close" no="Lukk" fa="بستن"/></button></header>
+    <img className="sina-lightbox-image" src={view.src} alt={view.alt}/>
+    <footer>
+     {views.length>1&&<button type="button" onClick={()=>step(-1)} aria-label="Previous photograph / Forrige bilde / تصویر قبلی"><ChevronLeft/></button>}
+     <p aria-live="polite"><T en={view.label[0]} no={view.label[1]} fa={view.label[2]}/><bdi dir="ltr"> · {index+1} / {views.length}</bdi></p>
+     {views.length>1&&<button type="button" onClick={()=>step(1)} aria-label="Next photograph / Neste bilde / تصویر بعدی"><ChevronRight/></button>}
+    </footer>
+   </div>
+  </dialog>
+ </div>;
+}
