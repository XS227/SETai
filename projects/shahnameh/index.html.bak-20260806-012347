<script>
(function(){
  "use strict";
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduced){ document.documentElement.classList.add('no-smooth'); }

  // reveal on scroll
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold:.14, rootMargin:'0px 0px -8% 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('in'); });
  }

  // subtle parallax on full-bleed images
  if(!reduced){
    var pEls = Array.prototype.slice.call(document.querySelectorAll('[data-parallax] img'));
    function parallax(){
      var vh = window.innerHeight;
      pEls.forEach(function(img){
        var r = img.parentElement.getBoundingClientRect();
        var mid = r.top + r.height/2;
        var offset = (mid - vh/2) * 0.08;
        img.style.transform = 'translateY(' + offset.toFixed(1) + 'px) scale(1.08)';
      });
    }
    document.addEventListener('scroll', function(){ requestAnimationFrame(parallax); }, {passive:true});
    parallax();
  }

  // hero intro video
  var heroVideo = document.querySelector('.hero-video');
  var heroSection = document.getElementById('hero');
  if(heroVideo){
    if(reduced){
      heroVideo.removeAttribute('autoplay');
      heroVideo.pause();
    } else {
      var playPromise = heroVideo.play();
      if(playPromise && playPromise.catch){ playPromise.catch(function(){}); }
      var vis = new IntersectionObserver(function(entries){
        if(entries[0].isIntersecting){ heroVideo.play().catch(function(){}); }
        else { heroVideo.pause(); }
      });
      vis.observe(heroSection);
    }
  }

  // header stays invisible until the hero has scrolled mostly out of view —
  // intro is pure video+text on first glance, per brief
  var siteHeader = document.getElementById('siteHeader');
  if(siteHeader && heroSection){
    if('IntersectionObserver' in window){
      var headerIO = new IntersectionObserver(function(entries){
        var e = entries[0];
        if(e.intersectionRatio < 0.35){ siteHeader.classList.add('show'); }
        else { siteHeader.classList.remove('show'); }
      }, {threshold:[0,.35,1]});
      headerIO.observe(heroSection);
    } else {
      siteHeader.classList.add('show');
    }
  }

  // ---------------- life-phase drag scrubber ----------------
  var track = document.getElementById('phaseTrack');
  var handle = document.getElementById('phaseHandle');
  var fill = document.getElementById('phaseFill');
  var stage = document.getElementById('phaseStage');
  if(track && handle && fill && stage){
    var stops = [0, 33.3333, 66.6667, 100];
    var panels = stage.querySelectorAll('.phase-panel');
    var pins = track.querySelectorAll('.phase-pin');
    var labels = document.querySelectorAll('.phase-labels span');
    var current = 1;

    function setPhase(n){
      current = n;
      var pct = stops[n-1];
      handle.style.left = pct + '%';
      fill.style.width = pct + '%';
      panels.forEach(function(p){ p.classList.toggle('active', parseInt(p.getAttribute('data-phase'),10) === n); });
      pins.forEach(function(p){ p.classList.toggle('active', parseInt(p.getAttribute('data-phase'),10) === n); });
      labels.forEach(function(l){ l.classList.toggle('active', parseInt(l.getAttribute('data-phase'),10) === n); });
      track.setAttribute('aria-valuenow', String(n));
    }

    function nearestPhase(pct){
      var best = 1, bestDist = Infinity;
      stops.forEach(function(s, i){
        var d = Math.abs(s - pct);
        if(d < bestDist){ bestDist = d; best = i+1; }
      });
      return best;
    }

    function pctFromClientX(clientX){
      var rect = track.getBoundingClientRect();
      var pct = ((clientX - rect.left) / rect.width) * 100;
      return Math.max(0, Math.min(100, pct));
    }

    var dragging = false;
    function onPointerDown(e){
      dragging = true;
      handle.setPointerCapture && e.pointerId != null && handle.setPointerCapture(e.pointerId);
      moveTo(e.clientX != null ? e.clientX : (e.touches && e.touches[0].clientX));
    }
    function onPointerMove(e){
      if(!dragging) return;
      var x = e.clientX != null ? e.clientX : (e.touches && e.touches[0] && e.touches[0].clientX);
      if(x == null) return;
      moveTo(x, true);
    }
    function onPointerUp(){
      if(!dragging) return;
      dragging = false;
      setPhase(current);
    }
    function moveTo(clientX, live){
      var pct = pctFromClientX(clientX);
      if(live){
        handle.style.left = pct + '%';
        fill.style.width = pct + '%';
      }
      current = nearestPhase(pct);
      if(!live){ setPhase(current); }
      else {
        panels.forEach(function(p){ p.classList.toggle('active', parseInt(p.getAttribute('data-phase'),10) === current); });
        pins.forEach(function(p){ p.classList.toggle('active', parseInt(p.getAttribute('data-phase'),10) === current); });
        labels.forEach(function(l){ l.classList.toggle('active', parseInt(l.getAttribute('data-phase'),10) === current); });
      }
    }

    handle.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', onPointerUp);

    track.addEventListener('click', function(e){
      if(e.target === handle) return;
      moveTo(e.clientX);
      setPhase(current);
    });

    pins.forEach(function(p){
      p.addEventListener('click', function(e){
        e.stopPropagation();
        setPhase(parseInt(p.getAttribute('data-phase'),10));
      });
    });

    labels.forEach(function(l){
      l.addEventListener('click', function(){ setPhase(parseInt(l.getAttribute('data-phase'),10)); });
    });

    track.addEventListener('keydown', function(e){
      if(e.key === 'ArrowRight' || e.key === 'ArrowUp'){ setPhase(Math.min(4, current+1)); e.preventDefault(); }
      if(e.key === 'ArrowLeft' || e.key === 'ArrowDown'){ setPhase(Math.max(1, current-1)); e.preventDefault(); }
    });

    setPhase(1);
  }
})();
</script>
